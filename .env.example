# Application
NODE_ENV=development
PORT=4000
APP_BASE_URL=https://smartblood.vn
ALLOWED_ORIGINS=http://localhost:5173,https://smartblood.vn

# SQL Server 2019 (HienMauDB)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=HienMauDB
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# JWT
JWT_SECRET=replace-with-64-char-random-secret-in-production
JWT_EXPIRES_IN=2h

# Zero-Trust Rare Blood Vault (32-byte hex = 64 hex chars per keyVersion)
VAULT_ACTIVE_KEY_VERSION=1
VAULT_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Gmail SMTP (OTP & Canh bao)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartBlood Red Cross <no-reply@smartblood.vn>

# Emergency fallback alert (comma-separated emails)
EMERGENCY_ONCALL_EMAILS=trucban@redcross-bienhoa.vn
EMERGENCY_ACK_TIMEOUT_MS=120000
